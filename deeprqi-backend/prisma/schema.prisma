// Phase 1 schema — the 5 tables from the build spec.
// Phase 2 addition: PostGIS geography column on Road for spatial queries
// ("roads within 5km"). Prisma can't natively type geography columns, so
// it's declared Unsupported() here and queried via $queryRaw in geo.js —
// the location column itself is still fully managed by Prisma migrations.
//
// All fields are camelCase for JS ergonomics; every field is explicitly
// @map'd to a snake_case DB column. The raw SQL in lib/geo.js,
// routes/roads.js, and routes/dashboard.js depends on these exact
// column names — do not change a @map value without updating those
// queries too (see PROJECT_CONTEXT.md "Important Constraints").

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  INSPECTOR
}

enum DetectionStatus {
  DETECTED
  VERIFIED
  FALSE_POSITIVE
  REPAIRED
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model User {
  id           String   @id @default(uuid()) @map("user_id")
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(INSPECTOR)
  createdAt    DateTime @default(now()) @map("created_at")

  uploadedImages  RoadImage[]   @relation("UploadedBy")
  repairsRecorded RepairEvent[] @relation("RecordedBy")
  complaintUpvotes ComplaintUpvote[]

  @@map("users")
}

model Road {
  id       String                                 @id @default(uuid()) @map("road_id")
  roadName String                                 @map("road_name")
  city     String?
  district String?
  state    String?
  lat      Float?
  lng      Float?
  // Written/read only via raw SQL in lib/geo.js — Prisma can't natively
  // write or query PostGIS geography columns.
  location Unsupported("geography(Point, 4326)")?

  geocodedAt DateTime? @map("geocoded_at")
  postcode   String?

  images         RoadImage[]
  scores         RqiScore[]
  repairEvents   RepairEvent[]
  surveySessions SurveySession[]
  complaints     Complaint[]

  @@map("roads")
}

model RoadImage {
  id           String   @id @default(uuid()) @map("image_id")
  roadId       String   @map("road_id")
  uploadedById String   @map("uploaded_by")
  imagePath    String   @map("image_path")
  // Milestone 11: public Supabase Storage URL for the persisted EigenCAM
  // heatmap PNG. Nullable -- older rows predate this, and images saved
  // as "pending analysis" (AI service was down) never got a heatmap.
  heatmapPath  String?  @map("heatmap_path")
  // Multi-model support: which named AI-service model produced this
  // inspection's detections (see ai-service/app/config.py MODEL_REGISTRY).
  // Nullable -- every row before this migration predates model selection
  // and implicitly used whatever the service's single default model was.
  modelUsed    String?  @map("model_used")
  lat          Float?
  lng          Float?
  imageWidth   Int?     @map("image_width")
  imageHeight  Int?     @map("image_height")
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  road       Road        @relation(fields: [roadId], references: [id])
  uploadedBy User        @relation("UploadedBy", fields: [uploadedById], references: [id])
  detections Detection[]
  scores     RqiScore[]

  @@map("road_images")
}

model Detection {
  id           String          @id @default(uuid()) @map("detection_id")
  imageId      String          @map("image_id")
  damageType   String          @map("damage_type")
  confidence   Float
  severity     String
  bbox         Json
  status       DetectionStatus @default(DETECTED) @map("status")
  verifiedById String?         @map("verified_by")
  verifiedAt   DateTime?       @map("verified_at")

  image RoadImage @relation(fields: [imageId], references: [id])

  @@map("detections")
}

model RqiScore {
  id            String    @id @default(uuid()) @map("rqi_id")
  roadId        String    @map("road_id")
  imageId       String?   @map("image_id")
  sessionId     String?   @map("session_id")
  score         Float
  category      String
  totalPenalty  Float     @map("total_penalty")
  breakdown     Json
  originalScore Float?    @map("original_score")
  recomputedAt  DateTime? @map("recomputed_at")
  generatedAt   DateTime  @default(now()) @map("generated_at")

  road    Road           @relation(fields: [roadId], references: [id])
  image   RoadImage?     @relation(fields: [imageId], references: [id])
  session SurveySession? @relation(fields: [sessionId], references: [id])

  @@map("rqi_scores")
}

model RepairEvent {
  id           String   @id @default(uuid()) @map("repair_id")
  roadId       String   @map("road_id")
  repairedAt   DateTime @map("repaired_at")
  recordedById String   @map("recorded_by")
  notes        String?

  road       Road @relation(fields: [roadId], references: [id])
  recordedBy User @relation("RecordedBy", fields: [recordedById], references: [id])

  @@map("repair_events")
}

model SurveySession {
  id              String    @id @default(uuid()) @map("session_id")
  roadId          String    @map("road_id")
  inspectorId     String    @map("inspector_id")
  startedAt       DateTime  @default(now()) @map("started_at")
  endedAt         DateTime? @map("ended_at")
  totalDistanceKm Float?    @map("total_distance_km")

  road   Road          @relation(fields: [roadId], references: [id])
  frames SurveyFrame[]
  scores RqiScore[]

  @@map("survey_sessions")
}

model SurveyFrame {
  id        String   @id @default(uuid()) @map("frame_id")
  sessionId String   @map("session_id")
  lat       Float
  lng       Float
  speed     Float?
  imagePath String?  @map("image_path")
  timestamp DateTime @default(now())

  session    SurveySession     @relation(fields: [sessionId], references: [id])
  detections SurveyDetection[]

  @@map("survey_frames")
}

model SurveyDetection {
  id         String @id @default(uuid()) @map("detection_id")
  frameId    String @map("frame_id")
  damageType String @map("damage_type")
  severity   String
  confidence Float

  frame SurveyFrame @relation(fields: [frameId], references: [id])

  @@map("survey_detections")
}

model Complaint {
  id          String          @id @default(uuid()) @map("complaint_id")
  roadId      String?         @map("road_id")
  lat         Float
  lng         Float
  description String
  imagePath   String?         @map("image_path")
  status      ComplaintStatus @default(OPEN)
  voterCount  Int             @default(1) @map("voter_count")
  createdAt   DateTime        @default(now()) @map("created_at")

  road Road? @relation(fields: [roadId], references: [id])
  upvotes ComplaintUpvote[]

  @@map("complaints")
}

model ComplaintUpvote {
  id          String   @id @default(uuid()) @map("upvote_id")
  complaintId String   @map("complaint_id")
  userId      String   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  complaint   Complaint @relation(fields: [complaintId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@unique([complaintId, userId])
  @@map("complaint_upvotes")
}

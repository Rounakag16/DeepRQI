# Copy to .env and fill in real values.

# Connection string from your Supabase or Neon project.
# Supabase: Project Settings -> Database -> Connection string (URI, "Session" mode is fine for dev)
# Neon: shown right on the project dashboard
DATABASE_URL="postgresql://user:password@host:5432/postgres?sslmode=require"

# Where the FastAPI AI service (Milestone 3) is running
FASTAPI_URL="http://localhost:8000"

# Any long random string. Example generation: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"

PORT=5000

# Milestone 11: Supabase Storage, for persisting uploaded road photos and
# their EigenCAM heatmaps. Project Settings -> API for the URL and the
# service_role key (NOT the anon/public key -- this must stay server-side).
# Create a PUBLIC bucket named to match SUPABASE_STORAGE_BUCKET first
# (Storage -> New bucket -> toggle "Public bucket" on).
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="change-me"
SUPABASE_STORAGE_BUCKET="road-images"

NOMINATIM_URL="https://nominatim.openstreetmap.org/reverse"
NOMINATIM_CONTACT="DeepRQI/1.0 (contact: your-email@example.com)"

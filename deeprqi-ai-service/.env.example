# Copy this file to .env and fill in real values.

# Path to your trained YOLO checkpoint. This is the *default* model.
# Before GPU training finishes, leave this unset (or point it at "yolo26s.pt")
# to run the service against the stock COCO checkpoint -- fine for testing the
# pipeline shape, not for real damage detection.
# Once training is done:
#   MODEL_PATH=/absolute/path/to/DeepRQI/runs/yolo26s_rdd2022/weights/best.pt
MODEL_PATH=yolo26s.pt

# Optional: what to call the MODEL_PATH model in API responses (GET /models,
# GET /health) and as the default for /predict?model=<name> when no model is
# specified. Purely a label -- doesn't need to match anything in
# MODEL_REGISTRY_JSON below (it's added under this name automatically).
DEFAULT_MODEL_NAME=default

# Optional: additional named models, loaded alongside the default one, so
# /predict?model=<name> can pick between them and POST /api/images/:id/compare
# (Node backend) can run one photo through several at once. JSON object of
# name -> checkpoint path. Leave unset until you have more than one trained
# model -- everything works with zero extra models configured.
#   MODEL_REGISTRY_JSON={"yolo26n_v1": "models/yolo26n_best.pt", "yolo26s_v1": "models/yolo26s_best.pt", "yolo26m_v1": "models/yolo26m_best.pt", "yolo26l_v1": "models/yolo26l_best.pt"}
MODEL_REGISTRY_JSON={"yolo26n_v1": "models/yolo26n_best.pt", "yolo26s_v1": "models/yolo26s_best.pt", "yolo26m_v1": "models/yolo26m_best.pt", "yolo26l_v1": "models/yolo26l_best.pt"}

